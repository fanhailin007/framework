        {
          "name": "Upload Document PDF - success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set('uploadedDocumentSlug', `uploaded-postman-document-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Upload ApiResponse is success', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.code).to.eql('OK');",
                  "  pm.expect(json.message).to.eql('success');",
                  "});",
                  "",
                  "pm.test('Uploaded document contains file metadata', function () {",
                  "  pm.expect(json.data.id).to.be.a('number');",
                  "  pm.expect(json.data.slug).to.eql(pm.collectionVariables.get('uploadedDocumentSlug'));",
                  "  pm.expect(json.data.status).to.eql('draft');",
                  "  pm.expect(json.data.filePath).to.be.a('string');",
                  "  pm.expect(json.data.fileSize).to.be.above(0);",
                  "  pm.expect(json.data.tags).to.include('pdf');",
